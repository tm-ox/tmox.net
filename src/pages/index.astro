---
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import Meta from "../components/Meta.astro";
import Modal from "../components/Modal.astro";
import Viewer from "../components/Viewer.astro";
import { getSite } from "../lib/site";

const data = await getSite();

// Hero headline: split around the accent phrase (owner-editable in pages/index.md).
const { title, accent } = data.hero;
const at = accent ? title.indexOf(accent) : -1;
if (accent && at < 0) throw new Error(`[home] hero.accent "${accent}" is not part of hero.title`);
const head = at < 0 ? [title, "", ""] : [title.slice(0, at), accent!, title.slice(at + accent!.length)];
---

<Layout title={data.title} description={data.description} footer={false}>
  <!-- Duotone for the hero dots: luminance mapped from slate #1e222e (shadows) to orange #ff9e64 (highlights). -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <filter id="duotone" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.118 1" />
        <feFuncG type="table" tableValues="0.133 0.62" />
        <feFuncB type="table" tableValues="0.18 0.392" />
      </feComponentTransfer>
    </filter>
  </svg>

  <!-- The whole site: one screen. Two buttons open the contact form and the portfolio in modals. -->
  <section id="top" class="hero">
    <div class="hero-dots" aria-hidden="true"></div>
    <div class="page hero-body">
      <p class="meta hero-in" style="--i:0">
        <Meta text={data.hero.kicker} />
      </p>
      <h1 class="mt-4 display-title hero-title hero-in" style="--i:1">
        {head[0]}{head[1] && <span class="hl">{head[1]}</span>}{head[2]}
      </h1>
      <p class="mt-6 text-lead text-text max-w-measure hero-in" style="--i:2">{data.hero.lead}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-4 hero-in" style="--i:3">
        <button type="button" class="btn-primary" data-modal-open="contact">{data.hero.contactCta}</button>
        <a class="btn-secondary" href="/portfolio.pdf" data-modal-open="portfolio">{data.hero.portfolioCta}</a>
      </div>
      {
        data.hero.availability && (
          <p class="mt-6 meta flex items-center gap-2 hero-in" style="--i:4">
            <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
            <Meta text={data.hero.availability} />
          </p>
        )
      }
    </div>
  </section>

  <!-- Portfolio modal: the viewer (components/Viewer.astro). Without JS the button on the home screen is
       a plain link to the PDF. -->
  <Modal id="portfolio" title={data.folio.title} variant="bare">
    <div slot="backdrop" class="hero-dots" aria-hidden="true"></div>
    <Viewer />
  </Modal>

  <!-- Contact modal -->
  <Contact />
</Layout>

<script>
  import "../scripts/modal.ts";
  import "../scripts/viewer.ts";
  import "../scripts/contact.ts";
</script>
