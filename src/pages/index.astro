---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getWork, getFeatured } from "../lib/work";
import Layout from "../layouts/Layout.astro";
import WorkRow from "../components/WorkRow.astro";
import Contact from "../components/Contact.astro";

const page = await getEntry("pages", "index");
if (!page) throw new Error("Missing content entry: pages/index");
const data = page.data;

const work = await getWork();

// Hero headline: split around the accent phrase (owner-editable in pages/index.md).
const { title, accent } = data.hero;
const at = accent ? title.indexOf(accent) : -1;
if (accent && at < 0) throw new Error(`[home] hero.accent "${accent}" is not part of hero.title`);
const head = at < 0 ? [title, "", ""] : [title.slice(0, at), accent!, title.slice(at + accent!.length)];
const featured = getFeatured(work);

// Every service proof slug must be a published project.
const byId = new Map(work.map((w) => [w.id, w]));
for (const s of data.services)
  for (const id of s.proof)
    if (!byId.has(id)) throw new Error(`[home] service "${s.id}": proof "${id}" is not a published project`);
---

<Layout title={data.title} description={data.description}>
  <!-- Hero: headline, lead, calls to action. (Reel.astro is parked, unused.) -->
  <section id="top" class="hero">
    <div class="hero-dots" aria-hidden="true"></div>
    <div class="page hero-body">
      <p class="meta hero-in" style="--i:0">{data.hero.kicker}</p>
      <h1 class="mt-4 hero-title hero-in" style="--i:1">
        {head[0]}{head[1] && <span class="hl">{head[1]}</span>}{head[2]}
      </h1>
      <p class="mt-6 text-lead text-text max-w-[52ch] hero-in" style="--i:2">{data.hero.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 hero-in" style="--i:3">
        <a class="btn-primary" href="#contact">Start a project</a>
        <a class="link text-sm inline-flex items-center gap-1 min-h-11" href="#work">
          See selected work
          <Icon name="ion:arrow-down" class="size-[1em]" aria-hidden="true" />
        </a>
      </div>
      {
        data.hero.availability && (
          <p class="mt-8 meta flex items-center gap-2 hero-in" style="--i:4">
            <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
            {data.hero.availability}
          </p>
        )
      }
    </div>
  </section>

  <!-- Duotone for the Selected work stage: luminance mapped from slate #1e222e (shadows) to orange #ff9e64 (highlights). -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <filter id="duotone" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.118 1" />
        <feFuncG type="table" tableValues="0.133 0.62" />
        <feFuncB type="table" tableValues="0.18 0.392" />
      </feComponentTransfer>
    </filter>
  </svg>

  <!-- Selected work: one module, an index of featured projects beside a stage that shows
       the hovered or focused one (global.css "Work list"). A plain row list on touch and narrow screens. -->
  <section id="work" class="page screen sect">
    <div class="sect-head"><h2 class="sect-title">Selected work</h2></div>
    <div class="sect-body">
      <div class="flex justify-end mb-4">
        <a href="/work" class="link text-sm inline-flex items-center gap-1 whitespace-nowrap">
          All {work.length} projects
          <Icon name="ion:arrow-forward" class="size-[1em]" aria-hidden="true" />
        </a>
      </div>
      <div class="wlist feat" data-screen="halftone" data-reveal="once">
        <span class="feat-hl" aria-hidden="true"></span>
        <ul class="wlist-rows">
          {featured.map((entry, i) => <WorkRow entry={entry} stage on={i === 0} eager={i === 0} />)}
        </ul>
        <div class="feat-stage" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="page screen sect">
    <div class="sect-head"><h2 class="sect-title">What I do</h2></div>
    <div class="sect-body">
    <ul class="grid gap-10 md:grid-cols-3 md:gap-x-10">
      {
        data.services.map((s, i) => (
          <li
            class="border-t border-line pt-8 md:border-t-0 md:pt-0 first:border-t-0 first:pt-0"
            data-reveal="once"
          >
            <p class="meta text-accent">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 text-h3 font-bold text-hi">{s.title}</h3>
            <p class="mt-3 text-base text-text">{s.intro}</p>
            <ul class="mt-5 grid gap-2 text-sm text-text">
              {s.deliverables.map((d) => (
                <li>
                  <span class="text-dim mr-2" aria-hidden="true">
                    —
                  </span>
                  {d}
                </li>
              ))}
            </ul>
            <p class="mt-6 text-sm text-muted">
              See:{" "}
              {s.proof.map((id, n) => (
                <>
                  {n > 0 && ", "}
                  <a class="link" href={`/work/${id}`}>
                    {byId.get(id)!.data.title}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="page screen sect">
    <div class="sect-head"><h2 class="sect-title">{data.about.title}</h2></div>
    <div class="sect-body max-w-[66ch] md:max-w-[58rem]">
      {
        data.about.paragraphs.map((p, i) => (
          <p class={i === 0 ? "statement max-w-[40ch]" : "mt-6 text-base max-w-[66ch]"}>
            {p}
          </p>
        ))
      }
      <dl class="mt-10 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="meta text-dim">Clients</dt>
          <dd class="mt-2 text-sm text-text">{data.about.clients.join(", ")}</dd>
        </div>
        <div>
          <dt class="meta text-dim">Tools</dt>
          <dd class="mt-2 text-sm text-text">{data.about.tools.join(", ")}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Contact -->
  <Contact
    title={data.contact.title}
    lead={data.contact.lead}
    note={data.contact.note}
  />
</Layout>

<script>
  import "../scripts/section-keys.ts";
</script>

<script>
  // Selected work stage. `is-on` marks the remembered row (without this script the CSS falls back
  // to the first project). Hovering or focusing a row picks it. With a mouse from 1024px the stage
  // also cycles on its own every CYCLE_MS, pausing while the pointer or focus is inside the module
  // or the tab or module is out of view, and never when the user prefers reduced motion.
  const CYCLE_MS = 3200; // time each project stays on the stage
  const wide = matchMedia("(min-width: 1024px) and (hover: hover)");
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  for (const feat of document.querySelectorAll<HTMLElement>(".feat")) {
    feat.style.setProperty("--feat-cycle", `${CYCLE_MS}ms`); // CSS ties the dot-screen fade to it
    const rows = [...feat.querySelectorAll<HTMLElement>(".wrow")];
    let current = Math.max(0, rows.findIndex((r) => r.classList.contains("is-on")));
    // Sliding highlight (.feat-hl): placed under the active row; the first placement is instant.
    const hl = feat.querySelector<HTMLElement>(".feat-hl");
    const place = () => {
      const on = rows[current];
      if (!hl || !on) return;
      hl.style.setProperty("--hl-y", `${on.offsetTop}px`);
      hl.style.setProperty("--hl-h", `${on.offsetHeight}px`);
    };
    const pick = (i: number) => {
      current = i;
      rows.forEach((r, n) => r.classList.toggle("is-on", n === i));
      place();
    };
    const mode = () => {
      feat.classList.toggle("has-hl", wide.matches);
      place();
    };
    mode();
    requestAnimationFrame(() => requestAnimationFrame(() => feat.classList.add("hl-anim")));
    wide.addEventListener("change", mode);
    addEventListener("resize", place);
    document.fonts?.ready.then(place); // row heights can change when the web font swaps in
    rows.forEach((row, i) => {
      row.addEventListener("pointerenter", () => pick(i));
      row.addEventListener("focusin", () => pick(i));
    });

    let timer: number | undefined;
    let visible = true;
    let inside = false;
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    const sync = () => {
      stop();
      if (wide.matches && !calm.matches && visible && !inside && !document.hidden)
        timer = window.setInterval(() => pick((current + 1) % rows.length), CYCLE_MS);
    };
    feat.addEventListener("pointerenter", () => ((inside = true), sync()));
    feat.addEventListener("pointerleave", () => ((inside = false), sync()));
    feat.addEventListener("focusin", () => ((inside = true), sync()));
    feat.addEventListener("focusout", (e) => {
      if (!feat.contains(e.relatedTarget as Node | null)) {
        inside = false;
        sync();
      }
    });
    document.addEventListener("visibilitychange", sync);
    wide.addEventListener("change", sync);
    calm.addEventListener("change", sync);
    new IntersectionObserver((entries) => {
      visible = entries.some((e) => e.isIntersecting);
      sync();
    }).observe(feat);
  }
</script>
