---
import Layout from "../layouts/Layout.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Meta from "../components/Meta.astro";
import Modal from "../components/Modal.astro";
import Viewer from "../components/Viewer.astro";
import { getSite } from "../lib/site";

const data = await getSite();

// Hero headline: split around the accent phrase (owner-editable in pages/index.md).
const { title, accent } = data.hero;
const at = accent ? title.indexOf(accent) : -1;
if (accent && at < 0) throw new Error(`[home] hero.accent "${accent}" is not part of hero.title`);
const head = at < 0 ? [title, "", ""] : [title.slice(0, at), accent!, title.slice(at + accent!.length)];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": "https://tmox.net/#site", url: "https://tmox.net/", name: "TMOX", inLanguage: "en" },
    {
      "@type": "ProfessionalService",
      "@id": "https://tmox.net/#service",
      name: "TMOX",
      url: "https://tmox.net/",
      description: data.description,
      image: "https://tmox.net/og.png",
      areaServed: "Worldwide",
      serviceType: ["Brand identity", "Print and document design", "Web and UI design"],
    },
  ],
};
---

<Layout title={data.title} description={data.description} jsonLd={jsonLd} footer={false}>
  <!-- The whole site: one screen, plus three dialogs (About, Work/portfolio, Contact) opened from the site menu in the
       header (Header.astro, SiteNav.astro). The hero keeps the one button, Get in touch. -->
  <section id="top" class="hero">
    <div class="hero-dots" aria-hidden="true"></div>
    <div class="page hero-body">
      <p class="meta hero-kicker hero-in" style="--i:0">
        <Meta text={data.hero.kicker} />
      </p>
      <h1 class="mt-4 display-title hero-title hero-in" style="--i:1">
        {head[0]}{head[1] && <span class="hl">{head[1]}</span>}{head[2]}
      </h1>
      <p class="mt-6 text-lead text-text max-w-measure hero-in" style="--i:2">{data.hero.lead}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-4 hero-in" style="--i:3">
        <a href="#contact" class="btn-primary" data-modal-open="contact">{data.hero.contactCta}</a>
      </div>
      {
        data.hero.availability && (
          <p class="mt-6 meta flex items-center gap-2 hero-in" style="--i:4">
            <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
            <Meta text={data.hero.availability} />
          </p>
        )
      }
    </div>
  </section>

  <!-- Portfolio dialog: the viewer (components/Viewer.astro). Without JS the Work link in the menu goes to /#portfolio and
       nothing opens; the PDF itself stays at /portfolio.pdf. -->
  <Modal id="portfolio" title={data.folio.title} variant="bare">
    <Viewer />
  </Modal>

  <About />
  <Contact />
</Layout>

<script>
  import "../scripts/modal.ts";
  import "../scripts/viewer.ts";
  import "../scripts/contact.ts";
  import "../scripts/tabs.ts";
</script>
