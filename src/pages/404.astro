---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found · TMOX"
  description="This page does not exist. Browse the selected work from the TMOX home page."
  noindex
>
  <section class="page page-body">
    <h1 class="sect-title">This page isn’t here.</h1>
    <p class="sect-after text-lead max-w-measure">
      The link is broken or the page has moved. Everything that’s live is in the
      work index.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn-primary" href="/#work">See the work</a>
      <a class="btn-secondary" href="/work">All projects</a>
    </div>
  </section>
</Layout>
