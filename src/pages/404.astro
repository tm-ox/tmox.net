---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found · TMOX" noindex>
  <section class="page py-24 md:py-32">
    <p class="meta">Error 404</p>
    <h1 class="mt-4 text-h1 font-extrabold text-hi">This page isn’t here.</h1>
    <p class="mt-6 text-lead max-w-[48ch]">
      The link is broken or the page has moved. Everything that’s live is in the
      work index.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn-primary" href="/#work">See the work</a>
      <a class="btn-secondary" href="/work">All projects</a>
    </div>
  </section>
</Layout>
