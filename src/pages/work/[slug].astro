---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import Ticket from "../../components/Ticket.astro";
import WorkRow from "../../components/WorkRow.astro";
import { getWork, neighbours } from "../../lib/work";

export async function getStaticPaths() {
  const collection = await getWork();
  return collection.map((page) => {
    const { prev, next } = neighbours(collection, page.id);
    return {
      params: { slug: page.id },
      props: {
        page,
        prev,
        next,
      },
    };
  });
}
const { page, prev, next } = Astro.props;
const data = page.data;
const site = await getEntry("pages", "index");
if (!site) throw new Error("Missing content entry: pages/index");
const tools = data.tools.map((t) => t.name.replace(/,+$/, "")).join(", ");
---

<Layout title={`${data.title} · TMOX`} description={data.description}>
  <article class="page pt-10 md:pt-16 pb-16 md:pb-24">
    <nav aria-label="Breadcrumb" class="meta">
      <a class="link" href="/work">All projects</a>
    </nav>
    <Ticket entry={page} class="mt-6" />
    <h1 class="mt-3 text-title font-extrabold text-accent max-w-measure-heading">{data.title}</h1>
    <div class="mt-8 md:mt-10 grid gap-8 md:grid-cols-12 md:gap-x-6">
      <p class="text-lead text-text max-w-measure md:col-span-7">
        {data.summary ?? data.description}
      </p>
      {
        (data.deliverables.length > 0 || tools || data.link) && (
          <dl class="grid grid-cols-[auto_1fr] content-start gap-x-6 gap-y-3 text-sm md:col-span-4 md:col-start-9">
            {data.deliverables.length > 0 && (
              <>
                <dt class="meta text-dim pt-0.5">Deliverables</dt>
                <dd class="text-text">
                  <ul>
                    {data.deliverables.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )}
            {tools && (
              <>
                <dt class="meta text-dim pt-0.5">Tools</dt>
                <dd class="text-text">{tools}</dd>
              </>
            )}
            {data.link && data.website && (
              <>
                <dt class="meta text-dim pt-0.5">Live site</dt>
                <dd class="text-text">
                  <a class="link" href={data.link} rel="noopener" target="_blank">
                    {data.website}
                  </a>
                  <Icon
                    name="ion:arrow-forward"
                    class="inline size-em-sm -rotate-45 ml-1"
                    aria-hidden="true"
                  />
                  <span class="sr-only">(opens in a new tab)</span>
                </dd>
              </>
            )}
          </dl>
        )
      }
    </div>

    <div class="mt-12 md:mt-16">
      <Gallery images={data.images} rows={data.rows} slug={page.id} />
    </div>

    <div class="border-t border-line mt-16 md:mt-24 pt-10 md:pt-12">
      <h2 class="text-h2 font-extrabold text-accent">Need something like this?</h2>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-4 items-center">
        <a class="btn-primary" href="/#contact">Start a project</a>
      </div>
    </div>

    <nav aria-label="Project navigation" class="mt-12 wlist" data-cols="2">
      <ul class="wlist-rows">
        <WorkRow entry={prev} label="Previous" as="span" back />
        <WorkRow entry={next} label="Next" as="span" />
      </ul>
    </nav>
  </article>
</Layout>
