---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/Gallery.astro";
import Ticket from "../../components/Ticket.astro";
import WorkRow from "../../components/WorkRow.astro";
import { getWork, neighbours } from "../../lib/work";

export async function getStaticPaths() {
  const collection = await getWork();
  return collection.map((page) => {
    const { prev, next } = neighbours(collection, page.id);
    return {
      params: { slug: page.id },
      props: {
        page,
        prev,
        next,
      },
    };
  });
}
const { page, prev, next } = Astro.props;
const data = page.data;
const site = await getEntry("pages", "index");
if (!site) throw new Error("Missing content entry: pages/index");
const tools = data.tools.map((t) => t.name.replace(/,+$/, "")).join(", ");
---

<Layout
  title={`${data.title} · TMOX`}
  description={data.description}
  tray={{
    prev: { href: `/work/${prev.id}`, title: prev.data.title },
    next: { href: `/work/${next.id}`, title: next.data.title },
    index: { href: "/work", label: "All projects" },
  }}
>
  <article class="page page-body">
    <h1 class="sect-title">{data.title}</h1>
    <nav aria-label="Breadcrumb" class="sect-after">
      <a class="link text-sm inline-flex items-center gap-1.5 whitespace-nowrap min-h-11" href="/work">
        <Icon name="ion:arrow-back" class="size-em" aria-hidden="true" />
        Back to all projects
      </a>
    </nav>
    <Ticket entry={page} class="mt-3" />
    {
      (data.deliverables.length > 0 || tools || data.link) && (
        <dl class="mt-3 grid gap-y-1 text-sm">
          {data.deliverables.length > 0 && (
            <div>
              <dt class="meta text-dim inline mr-3">Deliverables</dt>
              <dd class="inline text-text">
                {data.deliverables.map((d, i) => (
                  <>
                    {i > 0 && <span class="sep" aria-hidden="true">|</span>}
                    <span>{d}</span>
                  </>
                ))}
              </dd>
            </div>
          )}
          {(tools || (data.link && data.website)) && (
            <div>
              {tools && (
                <>
                  <dt class="meta text-dim inline mr-3">Tools</dt>
                  <dd class="inline text-text mr-6">{tools}</dd>
                </>
              )}
              {data.link && data.website && (
                <>
                  <dt class="meta text-dim inline mr-3">Live site</dt>
                  <dd class="inline text-text">
                    <a class="link" href={data.link} rel="noopener" target="_blank">
                      {data.website}
                    </a>
                    <Icon name="ion:arrow-forward" class="inline size-em-sm -rotate-45 ml-1" aria-hidden="true" />
                    <span class="sr-only">(opens in a new tab)</span>
                  </dd>
                </>
              )}
            </div>
          )}
        </dl>
      )
    }
    <p class="mt-block-sm text-lead text-text">{data.summary ?? data.description}</p>

    <div class="mt-block">
      <Gallery images={data.images} rows={data.rows} slug={page.id} />
    </div>

    <div class="border-t border-line mt-block-lg pt-block-sm">
      <h2 class="text-h2 font-extrabold text-accent">Need something like this?</h2>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-4 items-center">
        <a class="btn-primary" href="/#contact">Start a project</a>
      </div>
    </div>

    <nav aria-label="Project navigation" class="mt-block wlist" data-cols="2">
      <ul class="wlist-rows">
        <WorkRow entry={prev} label="Previous" as="span" back />
        <WorkRow entry={next} label="Next" as="span" />
      </ul>
    </nav>
  </article>
</Layout>
