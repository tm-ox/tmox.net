---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import TabNav from "../../components/TabNav.astro";
import Gallery from "../../components/Gallery.astro";
import { getWork, neighbours } from "../../lib/work";
import FadeOnce from "../../components/FadeOnce.astro";

export async function getStaticPaths() {
    const collection = await getWork();
    return collection.map((page) => {
        const { prev, next } = neighbours(collection, page.id);
        return {
            params: { slug: page.id },
            props: { page, prev: prev.id, next: next.id },
        };
    });
}
const { page, prev, next } = Astro.props;
const data = page.data;
---

<Layout title={`TMOX - ${data.title}`} description={data.description}>
    <p class="section-title">TMOX</p>
    <div class="sm:-mt-2 min-h-screen">
        <h1 class="sr-only">{data.title}</h1>
        <!-- Nav -->
        <TabNav>
            <a
                slot="prev"
                href={`/work/${prev}`}
                class="z-50 p-2 rounded-full shadow-md bg-secondary sm:p-1"
                aria-label="Previous project"
            >
                <Icon
                    name="ion:md-arrow-dropleft-circle"
                    class="icon"
                    aria-hidden="true"
                />
            </a>
            <a
                slot="next"
                href={`/work/${next}`}
                class="z-50 p-2 rounded-full shadow-md bg-secondary sm:p-1"
                aria-label="Next project"
            >
                <Icon
                    name="ion:md-arrow-dropright-circle"
                    class="icon"
                    aria-hidden="true"
                />
            </a>
        </TabNav>
        <!-- Details -->
        <FadeOnce origin="origin-top-left">
            <div class="mt-9 sm:mt-2">
                <p>Client:<strong class="ml-1">{data.client}</strong></p>
                {
                    data.client !== "Various" && (
                        <p>
                            Website:
                            <a href={data.link} target="_blank">
                                <strong class="ml-1">{data.website}</strong>
                            </a>
                        </p>
                    )
                }
                <p>Type:<strong class="ml-1">{data.type}</strong></p>
                <div class="flex flex-wrap">
                    <p class="mr-1 w-fit">Tools:</p>
                    {
                        data.tools.flatMap((tools: any) => (
                            <a
                                href={tools.link}
                                target="_blank"
                                class="flex justify-center"
                            >
                                <Image
                                    src={tools.icon}
                                    alt={tools.name}
                                    class="my-auto mr-1 w-auto h-3 rounded-none"
                                />
                                <p>
                                    <strong class="mr-1">{tools.name}</strong>
                                </p>
                            </a>
                        ))
                    }
                </div>
                <h2 class="mt-2 text-left lg:text-base">
                    {data.description}
                </h2>
            </div>
        </FadeOnce>
        <!-- Images -->
        <Gallery images={data.images} />
    </div>
</Layout>
