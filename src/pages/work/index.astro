---
import Layout from "../../layouts/Layout.astro";
import WorkRow from "../../components/WorkRow.astro";
import { getWork } from "../../lib/work";

const work = await getWork();
---

<Layout
  title="Projects · TMOX"
  description="Every published project: logos and identities, print, websites and app interfaces."
>
  <section class="page page-body">
    <h1 class="sect-title">Projects</h1>
    <div class="wlist sect-after" data-cols="2">
      <ol class="wlist-rows">
        {work.map((w, i) => <WorkRow entry={w} as="h2" eager={i < 4} />)}
      </ol>
    </div>
  </section>
</Layout>
