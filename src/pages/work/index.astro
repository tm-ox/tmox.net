---
import Layout from "../../layouts/Layout.astro";
import WorkRow from "../../components/WorkRow.astro";
import { getWork } from "../../lib/work";

const work = await getWork();
---

<Layout
  title="All projects · TMOX"
  description="Every published project: logos and identities, print, websites and app interfaces."
>
  <section class="page pt-10 md:pt-16 pb-16 md:pb-24">
    <p class="meta">Index</p>
    <h1 class="mt-3 text-h1 font-extrabold text-accent">All projects</h1>
    <p class="mt-4 text-lead">Every published job, numbered.</p>
    <div class="wlist mt-10" data-cols="2">
      <ol class="wlist-rows">
        {work.map((w, i) => <WorkRow entry={w} as="h2" eager={i < 4} />)}
      </ol>
    </div>
  </section>
</Layout>
