---
import Layout from "../layouts/Layout.astro";
import { getSite } from "../lib/site";

const { contact } = await getSite();
---

<Layout
  footer={false}
  title="Message sent | TMOX"
  description="Thanks for writing. Your message has been sent."
  noindex
>
  <section class="page page-body">
    <h1 class="sect-title">{contact.success.title}</h1>
    <p class="sect-after text-lead max-w-measure">
      {contact.success.body}
    </p>
    <div class="mt-8">
      <a class="btn-secondary" href="/#portfolio">{contact.success.back}</a>
    </div>
  </section>
</Layout>
