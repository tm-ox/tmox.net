---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Message sent · TMOX"
  description="Thanks. Your message has been sent and will be answered within a working day."
  noindex
>
  <section class="page page-body">
    <h1 class="sect-title">Thanks, got it.</h1>
    <p class="sect-after text-lead max-w-measure">
      I’ll reply to the address you gave within one working day.
    </p>
    <div class="mt-8">
      <a class="btn-secondary" href="/#work">Back to the work</a>
    </div>
  </section>
</Layout>
