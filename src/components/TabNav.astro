---
import { Icon } from "astro-icon/components";
---

<nav
  aria-label="Site"
  class="fixed top-[calc(100%-80px)] mx-auto right-1/2 translate-x-1/2 sm:sticky sm:top-[30px] sm:right-0 sm:mr-0 sm:translate-x-0 flex gap-1 w-fit transition-all z-50"
>
  <slot name="prev" />
  <div
    class="flex z-50 gap-3 py-2 px-4 h-12 rounded-full shadow-md sm:gap-2 bg-secondary sm:h-9 sm:px-3 sm:py-1"
  >
    <a href="/#home" class="icon" aria-label="Home">
      <Icon name="ion:md-hand" aria-hidden="true" />
    </a>
    <a href="/#work" class="icon" aria-label="Selected work">
      <Icon name="ion:document" aria-hidden="true" />
    </a>
    <a href="/#contact" class="icon" aria-label="Contact">
      <Icon name="ion:chatbubble-ellipses" aria-hidden="true" />
    </a>
  </div>
  <slot name="next" />
</nav>

<style>
  @reference "../styles/global.css";
  .active {
    @apply text-primary;
  }
</style>

<script>
  // Scroll-spy: highlight the nav link whose section crosses the viewport middle.
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  if (sections.length) {
    const links = new Map<string, HTMLAnchorElement>();
    document
      .querySelectorAll<HTMLAnchorElement>("nav a[href*='#']")
      .forEach((a) => links.set(new URL(a.href).hash.slice(1), a));

    const setActive = (id: string) => {
      links.forEach((a, key) => {
        const on = key === id;
        a.classList.toggle("active", on);
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
      },
      { rootMargin: "-45% 0px -45% 0px" }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
