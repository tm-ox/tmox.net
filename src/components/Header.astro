---
import Brand from "./Brand.astro";
---

<header class="page brand-row flex items-center">
  <Brand href="/" class="flex items-center gap-3 min-h-11" data-astro-prefetch="hover" />
</header>

<script>
  // Solid backing under the logo row (see global.css .brand-row). On the home page it only appears
  // once the hero is nearly gone; elsewhere, as soon as the page moves.
  const root = document.documentElement;
  const HERO_LEFT = 240; // px of hero still visible below the top when the backing switches on
  const hero = document.querySelector<HTMLElement>(".hero");
  const mark = () =>
    root.classList.toggle(
      "scrolled",
      hero ? hero.getBoundingClientRect().bottom < HERO_LEFT : window.scrollY > 4,
    );
  addEventListener("scroll", mark, { passive: true });
  mark();
</script>
