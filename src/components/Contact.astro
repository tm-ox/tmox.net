---
import Modal from "./Modal.astro";
import { getSite } from "../lib/site";

// Contact dialog: lead left, form right. The thank-you block replaces the form after sending
// (src/scripts/contact.ts); without JS the form posts to /sent.
const { contact: c } = await getSite();
---

<Modal id="contact" title={c.title} variant="custom-title">
  <div class="split">
    <div class="split-intro">
      <h2 id="contact-title" class="sect-title display-title">{c.title}</h2>
      <p class="text-lead max-w-measure-narrow">{c.lead}</p>
      {c.note && <p class="mt-4 meta">{c.note}</p>}
    </div>
    <form
      name="contact"
      method="POST"
      action="/sent"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="contact-form split-main"
      data-contact
    >
      <input type="hidden" name="form-name" value="contact" />
      <p hidden>
        <label
          >{c.honeypot}
          <input name="bot-field" tabindex="-1" autocomplete="off" /></label
        >
      </p>
      <fieldset class="field">
        <legend>{c.needsLegend} <span class="legend-hint">{c.needsHint}</span></legend>
        <div class="chips">
          {
            c.needs.map((n) => (
              <label class="chip">
                <input type="checkbox" name="need" value={n.value} /> {n.label}
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="contact-pair">
        <div class="field">
          <label for="c-name">{c.nameLabel} <span class="text-accent" aria-hidden="true">*</span></label>
          <input id="c-name" name="name" enterkeyhint="next" autocomplete="name" maxlength="100" required />
        </div>
        <div class="field">
          <label for="c-email">{c.emailLabel} <span class="text-accent" aria-hidden="true">*</span></label>
          <input id="c-email" name="email" enterkeyhint="next" type="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" required />
        </div>
      </div>
      <div class="field">
        <label for="c-msg">{c.messageLabel} <span class="text-accent" aria-hidden="true">*</span></label>
        <textarea id="c-msg" name="message" rows="4" maxlength="5000" required></textarea>
      </div>
      <div class="contact-send">
        <button class="btn-primary" type="submit">{c.send}</button>
        <span class="meta text-dim"><span aria-hidden="true">*</span> {c.requiredNote}</span>
      </div>
      <p class="contact-error" role="alert" data-error data-message={c.error}></p>
    </form>
    <div class="contact-done split-main" hidden data-done tabindex="-1" aria-labelledby="c-done-title">
      <p id="c-done-title" class="statement">{c.success.title}</p>
      <p class="mt-4 text-lead">{c.success.body}</p>
    </div>
  </div>
</Modal>
