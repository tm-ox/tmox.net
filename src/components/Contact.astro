---

const { title, lead, note } = Astro.props as {
  title: string;
  lead: string;
  note?: string;
};
const needs = [
  ["logo", "Logo"],
  ["print", "Print"],
  ["website", "Website"],
  ["ui", "App or UI"],
  ["other", "Other"],
];
---

<section id="contact" class="page screen sect">
  <div class="sect-head"><h2 class="sect-title">{title}</h2></div>
  <div class="sect-body grid gap-12 md:grid-cols-12 md:gap-x-6">
  <div class="md:col-span-5">
    <p class="text-lead max-w-measure-narrow">{lead}</p>
    {note && <p class="mt-4 meta">{note}</p>}
  </div>
  <div class="md:col-span-6 md:col-start-7">
    <form
      name="contact"
      method="POST"
      action="/sent"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="grid gap-4"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p hidden>
        <label
          >Leave this empty
          <input name="bot-field" tabindex="-1" autocomplete="off" /></label
        >
      </p>
      <div class="field">
        <label for="c-name">Name <span class="text-accent" aria-hidden="true">*</span></label>
        <input id="c-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="c-email">Email <span class="text-accent" aria-hidden="true">*</span></label>
        <input
          id="c-email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </div>
      <fieldset class="field">
        <legend>What do you need?</legend>
        <div class="chips">
          {
            needs.map(([value, label]) => (
              <label class="chip">
                <input type="radio" name="need" value={value} /> {label}
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field">
        <label for="c-msg">Message <span class="text-accent" aria-hidden="true">*</span></label>
        <textarea id="c-msg" name="message" rows="6" required></textarea>
      </div>
      <div><button class="btn-primary" type="submit">Send enquiry</button></div>
    </form>
  </div>
  </div>
</section>
