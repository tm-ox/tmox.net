---
import CopyEmail from "./CopyEmail.astro";

const { email, title, lead, note } = Astro.props as {
  email: string;
  title: string;
  lead: string;
  note?: string;
};
const needs = [
  ["logo", "Logo or identity"],
  ["print", "Print"],
  ["website", "Website"],
  ["ui", "App or UI"],
  ["other", "Something else"],
];
---

<section
  id="contact"
  class="page py-16 md:py-24 xl:py-32 border-t border-line grid gap-12 md:grid-cols-12 md:gap-x-6"
>
  <div class="md:col-span-5">
    <h2 class="text-h2 font-extrabold text-hi">{title}</h2>
    <p class="mt-4 text-lead max-w-[40ch]">{lead}</p>
    <p class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-1">
      <a href={`mailto:${email}`} class="link font-mono text-h3 text-hi break-all"
        >{email}</a
      >
      <CopyEmail email={email} />
    </p>
    {note && <p class="mt-4 meta">{note}</p>}
  </div>
  <div class="md:col-span-6 md:col-start-7">
    <form
      name="contact"
      method="POST"
      action="/sent"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="grid gap-6"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p hidden>
        <label
          >Leave this empty
          <input name="bot-field" tabindex="-1" autocomplete="off" /></label
        >
      </p>
      <div class="field">
        <label for="c-name">Name</label>
        <input id="c-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="c-email">Email</label>
        <input
          id="c-email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </div>
      <fieldset class="field">
        <legend>What do you need?</legend>
        <div class="flex flex-wrap gap-2">
          {
            needs.map(([value, label]) => (
              <label class="chip">
                <input type="radio" name="need" value={value} /> {label}
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="field">
        <label for="c-job"
          >Upwork job link <span class="text-dim">(optional)</span></label
        >
        <input
          id="c-job"
          name="job"
          type="url"
          inputmode="url"
          placeholder="https://www.upwork.com/jobs/…"
        />
      </div>
      <div class="field">
        <label for="c-msg">Message</label>
        <textarea id="c-msg" name="message" rows="6" required></textarea>
      </div>
      <div><button class="btn-primary" type="submit">Send enquiry</button></div>
    </form>
  </div>
</section>
