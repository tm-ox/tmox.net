---
import Brand from "./Brand.astro";
import IconButton from "./IconButton.astro";
import Menu from "./Menu.astro";
import { getSite } from "../lib/site";

// Full-viewport native <dialog>, laid out like any page of the site: the logo row (logo left, a link home that
// closes the dialog, the Close menu right, same position as on the home screen), then the title (.sect-title), then the body. Opened
// by any element with data-modal-open="<id>" (src/scripts/modal.ts), or by a matching URL hash
// (/#contact). Slots: default (body), "backdrop" (decoration behind the content).
// variant: "page"         logo row, title row, body
//          "custom-title" logo row, the body draws its own <h2 id="<id>-title">
//          "bare"         no logo row and no title (it only names the dialog): the body gets the whole viewport
interface Props {
  id: string;
  title: string;
  variant?: "page" | "bare" | "custom-title";
}
const { id, title, variant = "page" } = Astro.props;
const bare = variant === "bare";
const { site } = await getSite();
---

<dialog
  id={id}
  aria-labelledby={bare ? undefined : `${id}-title`}
  aria-label={bare ? title : undefined}
  data-bare={bare ? "" : undefined}
  class="modal fixed inset-0 m-0 h-dvh w-dvw max-h-none max-w-none border-0 p-0 text-text open:flex flex-col"
>
  <slot name="backdrop" />
  {
    !bare && (
      <>
        <div class="page modal-head">
          <Brand href="/" class="flex items-center gap-3 min-h-11" data-modal-close />
          <Menu>
            <IconButton icon="ion:close" label={site.close} side="left" data-modal-close />
          </Menu>
        </div>
        {variant === "page" && (
          <div class="page modal-titlebar">
            <h2 id={`${id}-title`} class="sect-title">{title}</h2>
          </div>
        )}
      </>
    )
  }
  <div class="page modal-body">
    <slot />
  </div>
</dialog>
