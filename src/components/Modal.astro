---

// Full-viewport <dialog> in the page's layout, padded below the layout header (the logo and site menu stay in
// Header.astro, above every dialog, so they never double up or move), then the title (.sect-title), then the body.
// Non-modal on purpose (see src/scripts/modal.ts). Opened by any element with data-modal-open="<id>", or by a
// matching URL hash (/#contact). Slots: default (body), "backdrop" (decoration behind the content).
// variant: "page"         title row, body
//          "custom-title" the body draws its own <h2 id="<id>-title">
//          "bare"         no header padding and no title (it only names the dialog): the body gets the whole
//                         viewport and the header folds into it (see "Site header" in global.css)
interface Props {
  id: string;
  title: string;
  variant?: "page" | "bare" | "custom-title";
}
const { id, title, variant = "page" } = Astro.props;
const bare = variant === "bare";
---

<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  data-bare={bare ? "" : undefined}
  tabindex="-1"
  class="modal fixed inset-0 m-0 h-dvh w-full max-h-none max-w-none border-0 text-text open:flex flex-col z-modal"
>
  <slot name="backdrop"><div class="hero-dots" aria-hidden="true"></div></slot>
  {
    variant === "page" ? (
      <div class="page modal-titlebar">
        <h2 id={`${id}-title`} class="sect-title">{title}</h2>
      </div>
    ) : (
      <h2 id={`${id}-title`} class="sr-only">{title}</h2>
    )
  }
  <div class="page modal-body">
    <slot />
  </div>
</dialog>
