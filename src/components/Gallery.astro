---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

type Kind = "screen" | "mobile" | "art" | "mark" | "photo";
type Mat = "none" | "dark" | "light" | "black" | "white";
interface Item {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  kind: Kind;
  mat?: Mat;
}
const { images, rows: rowsProp, slug } = Astro.props as {
  images: Item[];
  rows?: number[];
  slug: string;
};

// ---- per-image values -------------------------------------------------
const CAP_PX = 800; // matches min(80svh, 50rem) at its cap
const CAP_MARK_PX = 360;

function widthsFor(w: number) {
  const list = [400, 800, 1200, 1600].filter((n) => n <= w);
  if (!list.length || (list[list.length - 1] < w && w < 1600)) list.push(w);
  return list;
}

const all = await Promise.all(
  images.map(async (img, i) => {
    const large = await getImage({
      src: img.src,
      width: Math.min(1800, img.src.width),
      format: "webp",
    });
    const mat: Mat = img.mat ?? (img.kind === "mark" ? "dark" : "none");
    const r = img.kind === "mark" ? 1 : img.src.width / img.src.height;
    return {
      ...img,
      i,
      r,
      mat,
      large: large.src,
      num: String(i + 1).padStart(2, "0"),
      cap: img.caption ?? img.alt,
      widths: widthsFor(img.src.width),
    };
  })
);
type It = (typeof all)[number];

// ---- row grouping -----------------------------------------------------
function auto(): number[] {
  const out: number[] = [];
  let i = 0;
  while (i < all.length) {
    const k = all[i].kind;
    let j = i;
    while (j < all.length && all[j].kind === k) j++;
    const run = j - i;
    if (k === "mark") {
      if (run >= 5) out.push(run);
      else for (let n = run; n > 0; n -= 2) out.push(Math.min(2, n));
    } else if (k === "mobile") {
      let n = run;
      while (n > 0) {
        const take = n === 5 ? 3 : n === 6 ? 3 : Math.min(4, n);
        out.push(take);
        n -= take;
      }
    } else {
      for (let n = 0; n < run; n++) out.push(1);
    }
    i = j;
  }
  return out;
}

const counts = rowsProp ?? auto();
const total = counts.reduce((a, b) => a + b, 0);
if (total !== all.length) {
  throw new Error(`[gallery] ${slug}: rows sum to ${total} but there are ${all.length} images`);
}

let cursor = 0;
const rows = counts.map((n) => {
  const items: It[] = all.slice(cursor, cursor + n);
  cursor += n;
  const allMarks = items.every((x) => x.kind === "mark");
  const allMobile = items.length >= 2 && items.every((x) => x.kind === "mobile");
  const sum = items.reduce((a, x) => a + x.r, 0);
  const type =
    items.length >= 5 && allMarks ? "sheet" : allMobile ? "phones" : "justified";
  const allPortrait = items.every((x) => x.r < 1);
  const m = allMarks || (allPortrait && items.length <= 2)
    ? "keep"
    : allPortrait
      ? "wrap2"
      : "stack";
  const capPx = allMarks ? CAP_MARK_PX : CAP_PX;
  const capW = Math.min(1184, capPx * sum);
  const mobile = m === "stack" ? 100 : m === "wrap2" ? 50 : null;
  const sized = items.map((x) => {
    const share = x.r / sum;
    let sizes: string;
    if (type === "phones") sizes = "(min-width:640px) 300px, 50vw";
    else if (type === "sheet")
      sizes = "(min-width:1280px) 190px, (min-width:768px) 33vw, 50vw";
    else
      sizes = `(min-width:1280px) ${Math.round(capW * share)}px, (min-width:640px) ${Math.round(share * 100)}vw, ${mobile ?? Math.round(share * 100)}vw`;
    return { ...x, sizes };
  });
  return { items: sized, type, m, allMarks, sum: sum.toFixed(4) };
});
---

<div class="gallery" data-gallery>
  {
    rows.map((row) => (
      <ul
        class="g-row"
        data-type={row.type}
        data-m={row.m}
        data-marks={row.allMarks && row.type === "justified" ? "" : undefined}
        style={`--n:${row.items.length};--sum:${row.sum}`}
        data-reveal="once"
      >
        {row.items.map((it) => (
          <li class="g-item" style={`--r:${it.r.toFixed(4)}`}>
            <a
              href={it.large}
              class="g-link"
              data-lightbox
              data-mat={it.mat}
              data-caption={it.cap}
              data-num={it.num}
              aria-label={`${it.alt}, view larger`}
            >
              <div class="g-media" data-mat={it.mat} data-kind={it.kind}>
                <Image
                  src={it.src}
                  alt={it.alt}
                  widths={it.widths}
                  sizes={it.sizes}
                  loading={it.i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
            </a>
            <p class="g-cap">
              <span class="g-num">{it.num}</span>
              {it.cap}
            </p>
          </li>
        ))}
      </ul>
    ))
  }
</div>

<dialog
  id="lightbox"
  aria-label="Image viewer"
  class="fixed inset-0 m-0 h-dvh w-dvw max-h-none max-w-none border-0 p-0 bg-backdrop/[0.97] text-text open:grid grid-rows-[56px_1fr_64px]"
>
  <div class="page flex items-center justify-between">
    <p class="meta text-text" data-lb-count aria-live="polite"></p>
    <button
      type="button"
      class="btn-ghost btn-sm"
      data-lb-close
      aria-label="Close image viewer"
    >
      Close<kbd class="ml-2 hidden text-meta text-dim sm:inline">Esc</kbd>
    </button>
  </div>
  <div class="grid min-h-0 place-items-center px-4 sm:px-16" data-lb-stage>
    <img
      alt=""
      class="max-h-full max-w-full object-contain"
      data-lb-img
      draggable="false"
    />
  </div>
  <div class="page grid grid-cols-[48px_1fr_48px] items-center gap-4">
    <button
      type="button"
      class="inline-flex size-12 items-center justify-center rounded-[var(--radius-ctl)] text-text hover:bg-raised hover:text-hi"
      data-lb-prev
      aria-label="Previous image"
    >
      <Icon name="ion:chevron-back" class="size-6" aria-hidden="true" />
    </button>
    <p class="g-cap text-center" data-lb-caption></p>
    <button
      type="button"
      class="inline-flex size-12 items-center justify-center rounded-[var(--radius-ctl)] text-text hover:bg-raised hover:text-hi"
      data-lb-next
      aria-label="Next image"
    >
      <Icon name="ion:chevron-forward" class="size-6" aria-hidden="true" />
    </button>
  </div>
</dialog>

<script>
  import "../scripts/lightbox.ts";
</script>
