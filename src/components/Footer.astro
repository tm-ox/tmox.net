---
import Brand from "./Brand.astro";
import { getSite } from "../lib/site";

const { footer, site } = await getSite();
---

<footer class="site-foot bg-sunk border-t border-line">
  <div class="page py-12 md:py-16 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4">
      <Brand href="/" class="inline-flex items-center gap-3" />
      <p class="mt-3 text-sm text-muted max-w-measure-narrow">{footer.line}</p>
    </div>
    <div class="md:col-span-3">
      <p class="meta text-dim">{footer.pagesTitle}</p>
      <ul class="mt-1 grid text-sm [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center">
        <li><a href="/#portfolio" class="link" data-modal-open="portfolio">{footer.portfolio}</a></li>
        <li><a href="/folio.pdf" class="link">{footer.portfolioPdf}</a></li>
        <li><a href="/#contact" class="link" data-modal-open="contact">{footer.contact}</a></li>
      </ul>
    </div>
    <div class="md:col-span-5">
      <p class="meta text-dim">{footer.colophonTitle}</p>
      <p class="mt-3 text-sm text-muted max-w-measure">{footer.colophon}</p>
    </div>
    <p class="md:col-span-12 border-t border-line pt-6 meta text-dim">
      © {new Date().getFullYear()} {site.brand}
    </p>
  </div>
</footer>
