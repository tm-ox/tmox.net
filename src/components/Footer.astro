---
import Logo from "./Logo.astro";

const { email, line } = Astro.props as { email: string; line: string };
---

<footer class="bg-sunk border-t border-line">
  <div class="page py-12 md:py-16 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href="/" class="inline-flex items-center gap-2" aria-label="TMOX, home">
        <Logo class="size-[22px] text-accent" knock="var(--color-sunk)" />
        <span
          class="font-sans text-[15px] font-extrabold tracking-[0.06em] text-hi"
          aria-hidden="true">TMOX</span
        >
      </a>
      <p class="mt-3 text-sm text-muted max-w-[32ch]">{line}</p>
    </div>
    <div class="md:col-span-3">
      <p class="meta text-dim">Contact</p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li>
          <a href={`mailto:${email}`} class="link font-mono">{email}</a>
        </li>
        <li><a href="/#services" class="link">Services</a></li>
        <li><a href="/#about" class="link">About</a></li>
        <li><a href="/work" class="link">All projects</a></li>
      </ul>
    </div>
    <div class="md:col-span-5">
      <p class="meta text-dim">Colophon</p>
      <p class="mt-3 text-sm text-muted max-w-[48ch]">
        Set in Schibsted Grotesk and IBM Plex Mono. Built with Astro and
        Tailwind CSS, hosted on Netlify.
      </p>
    </div>
    <p class="md:col-span-12 border-t border-line pt-6 meta text-dim">
      © {new Date().getFullYear()} TMOX
    </p>
  </div>
</footer>
