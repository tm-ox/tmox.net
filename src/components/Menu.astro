---
// The bordered box of square boxes (IconButtons): one control wide, 1px dividers, rounded outside.
// Position it with a class from the parent's scope (e.g. .viewer-menu).
interface Props {
  direction?: "column" | "row";
  class?: string;
  role?: astroHTML.JSX.AriaRole;
  as?: "div" | "nav"; // the element; a labelled site menu is a <nav>
  label?: string; // aria-label
}
const { direction = "column", class: className, role, label, as: Tag = "div" } = Astro.props;
---

<Tag class:list={["menu", direction === "row" && "menu-row", className]} role={role} aria-label={label}>
  <slot />
</Tag>
