---
import type { Work } from "../lib/work";

// "full": project page header. "short": work rows (client when it differs from the
// title, disciplines, year); the row shows the No. on its own line.
interface Props {
  entry: Work;
  variant?: "full" | "short";
  class?: string;
  id?: string;
}
const LABEL = { brand: "Brand", print: "Print", web: "Web", ui: "UI" } as const;
const { entry, variant = "full", class: className = "", id } = Astro.props;
const d = entry.data;
const no = `No.${String(d.order).padStart(2, "0")}`;
const disc = d.discipline.map((k) => LABEL[k]).join(" · ");
const parts =
  variant === "short"
    ? [d.client === d.title ? undefined : d.client, disc, d.year]
    : [no, d.client, d.role ?? d.type, disc, d.year];
const items = parts
  .filter((p) => p !== undefined && p !== "")
  .map((p) => String(p));
---

<p class={`meta ${className}`} id={id}>
  {
    items.map((p, i) => (
      <>
        {i > 0 && (
          <span class="text-dim" aria-hidden="true">
            {" / "}
          </span>
        )}
        <span>{p}</span>
      </>
    ))
  }
</p>
