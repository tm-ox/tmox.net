---
import { Icon } from "astro-icon/components";
import IconButton from "./IconButton.astro";
import Menu from "./Menu.astro";
import folio from "../data/folio.json";
import { getSite } from "../lib/site";

// Portfolio viewer: shows one PDF page at a time, contained in the viewport (arrows, keys, swipe, click
// the page for the next; src/scripts/viewer.ts). "Open" shows the PDF in the browser's own viewer,
// "Download" saves it. The text of every page follows, hidden visually. Pages come from the PDF:
// `npm run folio` renders public/folio/NN-{800,1600}.webp and src/data/folio.json.
const { folio: t } = await getSite();
const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k]));
const [small, large] = folio.widths;
const pages = Array.from({ length: folio.pages }, (_, i) => String(i + 1).padStart(2, "0"));
---

<div class="viewer" data-viewer data-live-format={t.live} style={`--folio-ratio: ${folio.ratio}`}>
  <div class="viewer-rail" aria-hidden="true">
    {pages.map((_, i) => <span class="viewer-tick" data-go={i} />)}
  </div>
  <div class="viewer-main">
    <button type="button" class="viewer-side" data-prev aria-label={t.prev}>
      <span class="viewer-chip"><Icon name="ion:chevron-back" class="nav-ico" aria-hidden="true" /></span>
    </button>
    <div class="viewer-stage">
      <ol class="viewer-pages">
        {
          pages.map((n, i) => (
            <li class="viewer-slide" hidden={i > 0} data-slide>
              <img
                src={`/folio/${n}-${small}.webp`}
                srcset={`/folio/${n}-${small}.webp ${small}w, /folio/${n}-${large}.webp ${large}w`}
                sizes="(min-width: 1376px) 1280px, (min-width: 1024px) calc(100vw - 6rem), (min-width: 640px) calc(100vw - 4rem), 100vw"
                width={large}
                height={Math.round(large / folio.ratio)}
                alt={fill(t.pageAlt, { n: i + 1, total: folio.pages })}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </li>
          ))
        }
      </ol>
      <span class="viewer-half" data-half="prev" aria-hidden="true"></span>
      <span class="viewer-half" data-half="next" aria-hidden="true"></span>
    </div>
    <button type="button" class="viewer-side" data-next autofocus aria-label={t.next}>
      <span class="viewer-chip"><Icon name="ion:chevron-forward" class="nav-ico" aria-hidden="true" /></span>
    </button>
    <Menu class="viewer-menu">
      <IconButton icon="ion:close" label={t.closeLabel} tip={t.closeTip} side="left" data-modal-close />
      <IconButton icon="ion:open-outline" label={t.openLabel} tip={t.openTip} side="left" href="/portfolio.pdf" newTab />
      <IconButton icon="ion:download-outline" label={t.downloadLabel} tip={t.downloadTip} side="left" href="/portfolio.pdf" download />
    </Menu>
    <Menu class="viewer-menu viewer-keys" role="list" label={t.keysLabel}>
      {t.keys.map((k) => <IconButton text={k.key} label={k.label} side="right" role="listitem" />)}
    </Menu>
  </div>
  <p class="viewer-hint meta">{t.hint}</p>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>
<div class="sr-only">
  {folio.text.map((text, i) => <p>{fill(t.pageText, { n: i + 1, text })}</p>)}
</div>
