---
interface Props {
  email: string;
  class?: string;
}
const { email, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-1 ${className}`}>
  <button type="button" class="copy-btn btn-ghost btn-sm" data-copy={email}
    >Copy</button
  >
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</span>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const status = btn.parentElement?.querySelector("[data-copy-status]");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      } catch {
        return;
      }
      btn.textContent = "Copied";
      if (status) status.textContent = "Email address copied";
      setTimeout(() => {
        btn.textContent = "Copy";
        if (status) status.textContent = "";
      }, 2000);
    });
  });
</script>
