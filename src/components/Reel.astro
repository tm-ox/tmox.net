---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Work } from "../lib/work";

// Project reel for the hero: one small proof per published project, drifting in a
// full-bleed strip. The list is drawn twice for a seamless loop; the copy is inert.
// Styles and timing: global.css "Project reel" and the --reel-* tunables.
interface Props {
  work: Work[];
}
const { work } = Astro.props;

// Card aspect: mats are square, sheets 3:2, cropped covers use their mobile aspect.
const AR = { "4/3": 4 / 3, "3/2": 3 / 2, "4/5": 4 / 5 } as const;
const MAX_H = 168; // CSS px, the --reel-h cap (10.5rem)
const MIN_H = 104; // 6.5rem
const cards = work.map((w) => {
  const c = w.data.cover;
  const contain = !!c.sheet || c.fit === "contain";
  const ar = c.sheet ? 3 / 2 : contain ? 1 : AR[c.mobileAspect];
  return {
    id: w.id,
    title: w.data.title,
    no: String(w.data.order).padStart(2, "0"),
    src: c.src,
    position: c.position,
    contain,
    mat: contain ? c.mat : "none",
    ar,
    sizes: `(min-width:768px) ${Math.round(MAX_H * ar)}px, ${Math.round(MIN_H * ar)}px`,
  };
});
// Keep each set wider than a wide screen even if few projects are published.
const set = cards.length >= 8 ? cards : [...cards, ...cards, ...cards].slice(0, Math.max(8, cards.length));
---

<div class="reel hero-in" style={`--i:5;--n:${set.length}`}>
  <div class="page flex items-center justify-between gap-4 mb-3">
    <p class="meta text-dim">{work.length} published projects</p>
    <label class="reel-toggle">
      <input type="checkbox" class="sr-only" />
      <span class="sr-only">Pause the project reel</span>
      <span class="reel-state is-pause" aria-hidden="true">
        <Icon name="ion:pause" />Pause
      </span>
      <span class="reel-state is-play" aria-hidden="true">
        <Icon name="ion:play" />Play
      </span>
    </label>
  </div>
  <div class="reel-window">
    <div class="reel-track">
      {
        [0, 1].map((copy) => (
          <ul class="reel-set" aria-hidden={copy ? "true" : undefined} inert={copy ? true : undefined}>
            {set.map((c, i) => (
              <li class="reel-card">
                <a
                  href={`/work/${c.id}`}
                  class="reel-link"
                  data-astro-prefetch="hover"
                  tabindex={copy ? -1 : undefined}
                >
                  <span class="reel-media" data-mat={c.mat} style={`--ar:${c.ar}`}>
                    <Image
                      src={c.src}
                      alt=""
                      class={c.contain ? "object-contain p-mat" : "object-cover"}
                      style={c.contain ? undefined : `object-position:${c.position}`}
                      widths={[240, 480]}
                      quality={70}
                      sizes={c.sizes}
                      loading={!copy && i < 4 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </span>
                  <span class="reel-cap">
                    <span class="reel-num">{c.no}</span>
                    {c.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>
