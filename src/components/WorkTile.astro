---
import { Image } from "astro:assets";
import type { Work } from "../lib/work";
import Ticket from "./Ticket.astro";

interface Props {
  entry: Work;
  span: 4 | 5 | 6 | 7 | 8 | 12;
  row: 1 | 2 | 3;
  eager?: boolean;
}
const { entry, span, row, eager = false } = Astro.props;
const { data } = entry;
const cover = data.cover;

const SPAN = {
  4: "md:col-span-4",
  5: "md:col-span-5",
  6: "md:col-span-6",
  7: "md:col-span-7",
  8: "md:col-span-8",
  12: "md:col-span-12",
};
const ROW_H = {
  1: "md:h-[clamp(300px,40vw,540px)]",
  2: "md:h-[clamp(260px,33vw,440px)]",
  3: "md:h-[clamp(260px,33vw,440px)]",
};
const MOBILE_ASPECT = {
  "4/3": "aspect-[4/3]",
  "3/2": "aspect-[3/2]",
  "4/5": "aspect-[4/5]",
};
const loading = eager ? "eager" : "lazy";
const fetchpriority = eager ? "high" : "auto";
const sizes = `(min-width:1280px) ${Math.round((span / 12) * 1184)}px, (min-width:768px) ${Math.round((span / 12) * 100)}vw, 100vw`;
const isSheet = !!cover.sheet;
const mat = isSheet || cover.fit === "contain" ? cover.mat : "none";
---

<li class={`col-span-4 ${SPAN[span]}`} data-reveal="once">
  <a href={`/work/${entry.id}`} class="tile group block" data-astro-prefetch="hover">
    <div
      class={`tile-media ${MOBILE_ASPECT[cover.mobileAspect]} md:aspect-auto ${ROW_H[row]} ${isSheet ? "grid grid-cols-3 grid-rows-2 gap-[4%] p-[6%]" : ""} ${!isSheet && cover.fit === "contain" ? "p-[8%]" : ""}`}
      data-mat={mat}
    >
      {
        isSheet ? (
          cover.sheet!.map((s) => (
            <Image
              src={s}
              alt=""
              class="size-full object-contain"
              widths={[240, 400]}
              sizes="(min-width:768px) 200px, 30vw"
              loading={loading}
              fetchpriority={fetchpriority}
            />
          ))
        ) : cover.fit === "contain" ? (
          <Image
            src={cover.src}
            alt={cover.alt}
            class="size-full object-contain"
            widths={[480, 800, 1200]}
            sizes={sizes}
            loading={loading}
            fetchpriority={fetchpriority}
          />
        ) : (
          <Image
            src={cover.src}
            alt={cover.alt}
            class="size-full object-cover"
            style={`object-position:${cover.position}`}
            widths={[480, 800, 1200, 1600]}
            sizes={sizes}
            loading={loading}
            fetchpriority={fetchpriority}
          />
        )
      }
    </div>
    <div class="mt-3">
      <Ticket entry={entry} variant="short" />
      <h3 class="mt-1 text-h3 font-bold text-hi">
        <span class="tile-title">{data.title}</span>
      </h3>
      <p class="mt-1 text-sm text-muted max-w-[52ch]">{data.description}</p>
    </div>
  </a>
</li>
