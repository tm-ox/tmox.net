---
import { Image } from "astro:assets";
import type { Work } from "../lib/work";
import Ticket from "./Ticket.astro";

interface Props {
  entry: Work;
  eager?: boolean;
}
const { entry, eager = false } = Astro.props;
const { data } = entry;
const cover = data.cover;

const loading = eager ? "eager" : "lazy";
const fetchpriority = eager ? "high" : "auto";
const sizes = "(min-width:1280px) 384px, (min-width:1024px) 33vw, (min-width:768px) 50vw, 100vw";
const isSheet = !!cover.sheet;
const mat = isSheet || cover.fit === "contain" ? cover.mat : "none";
---

<li data-reveal="once">
  <a href={`/work/${entry.id}`} class="tile group block" data-astro-prefetch="hover">
    <div
      class={`tile-media aspect-[4/3] ${isSheet ? "grid grid-cols-3 grid-rows-2 gap-[4%] p-[6%]" : ""} ${!isSheet && cover.fit === "contain" ? "p-[8%]" : ""}`}
      data-mat={mat}
    >
      {
        isSheet ? (
          cover.sheet!.map((s) => (
            <Image
              src={s}
              alt=""
              class="size-full object-contain"
              widths={[240, 400]}
              sizes="(min-width:768px) 200px, 30vw"
              loading={loading}
              fetchpriority={fetchpriority}
            />
          ))
        ) : cover.fit === "contain" ? (
          <Image
            src={cover.src}
            alt={cover.alt}
            class="size-full object-contain"
            widths={[480, 800, 1200]}
            sizes={sizes}
            loading={loading}
            fetchpriority={fetchpriority}
          />
        ) : (
          <Image
            src={cover.src}
            alt={cover.alt}
            class="size-full object-cover"
            style={`object-position:${cover.position}`}
            widths={[480, 800, 1200, 1600]}
            sizes={sizes}
            loading={loading}
            fetchpriority={fetchpriority}
          />
        )
      }
    </div>
    <div class="mt-3">
      <Ticket entry={entry} variant="short" />
      <h3 class="mt-1 text-h3 font-bold">
        <span class="tile-title">{data.title}</span>
      </h3>
      <p class="mt-1 text-sm text-muted max-w-[52ch]">{data.description}</p>
    </div>
  </a>
</li>
