---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LogoDefs from "../components/LogoDefs.astro";
import folio from "../data/folio.json";
import { getSite } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string | false;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: object;
  footer?: boolean;
}
const { title, description, image, imageAlt, noindex, jsonLd, footer = true } = Astro.props;
const { site } = await getSite();
// The PDF page ratio, on every page: --site-x (the shared content width) is computed from it. A style attribute on
// <html> would need a CSP style-src allowance if a strict policy is ever added; then move it to a <style> block.
const rootStyle = `--folio-ratio: ${folio.ratio}`;
---

<html lang="en" class="bg-bg text-text font-sans antialiased" style={rootStyle}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 z-skip bg-accent text-on-accent font-semibold text-sm px-3 py-2 rounded-ctl"
      >{site.skip}</a
    >
    <LogoDefs />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
