---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LogoDefs from "../components/LogoDefs.astro";
import { getSite } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  footer?: boolean;
}
const { title, description, image, noindex, footer = true } = Astro.props;
const { site } = await getSite();
---

<html lang="en" class="bg-bg text-text font-sans antialiased">
  <head>
    <script is:inline>
      // `js` gates the transparent logo-row backing at the top of the page (see .brand-row in global.css).
      document.documentElement.classList.add("js");
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 z-skip bg-accent text-on-accent font-semibold text-sm px-3 py-2 rounded-ctl"
      >{site.skip}</a
    >
    <LogoDefs />
    <Header />
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
