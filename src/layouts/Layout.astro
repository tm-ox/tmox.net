---
import BaseHead from "../components/BaseHead.astro";
import Logo from "../components/Logo.astro";
import Footer from "../components/Footer.astro";

const { title, description, image, noindex } = Astro.props;
---

<html
  lang="en"
  class="tracking-wide bg-background text-primary font-jakarta scroll-smooth"
>
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body class="overflow-x-hidden relative">
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 z-[60] px-3 py-1 rounded-md bg-primary text-background text-sm font-bold"
      >Skip to content</a
    >
    <!-- Background -->
    <div class="bg-rings" aria-hidden="true"></div>
    <!-- /Background -->
    <main id="main" class="w-[95%] max-w-screen-xl mx-auto mb-16">
      <header class="fixed top-[20px] sm:top-[30px] w-fit z-40">
        <a href="/" aria-label="TMOX, home"><Logo /></a>
      </header>
      <slot />
    </main>
    <footer
      class="flex flex-wrap gap-1 justify-center items-center pt-2 pb-1 w-screen bg-linear-to-b from-background via-secondary to-secondary"
    >
      <Footer />
    </footer>
    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>
