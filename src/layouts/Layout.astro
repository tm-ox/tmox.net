---
import { getEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description, image, noindex } = Astro.props;
const site = await getEntry("pages", "index");
if (!site) throw new Error("Missing content entry: pages/index");
---

<html lang="en" class="bg-bg text-text font-sans antialiased">
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-2 left-2 z-[60] bg-accent text-on-accent font-semibold text-sm px-3 py-2 rounded-[var(--radius-ctl)]"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer line={site.data.footer.line} />
    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>
